# Copy to .env for local development. .env is git-ignored: never commit real values.
# Production values are set in the Render dashboard (API) and GitHub secrets (deploy tokens).

# ---------------------------------------------------------------- API (services/api)
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Leave DATABASE_URL unset to use the embedded PGlite database (services/api/.data/pglite).
# Set it to use a real PostgreSQL server instead.
# DATABASE_URL=postgresql://smartfin:smartfin@localhost:5432/smartfin

# PGlite data directory, or "memory" for a throwaway database.
# PGLITE_DATA_DIR=.data/pglite

# Apply pending migrations at startup (default: true outside production).
# MIGRATE_ON_START=true

# Reverse proxies in front of the API: 0 locally, 2 behind Vercel + Render.
# TRUST_PROXY_HOPS=0

# RATE_LIMIT_PER_MINUTE=300
# Sign-in attempts per IP and email per 15 minutes (sign-ups: per IP per hour).
# AUTH_RATE_LIMIT=10
# Comma-separated web origins allowed to make signed-in changes (recommended in production),
# e.g. https://smartfin.vercel.app. Unset: only the CSRF token is checked.
# WEB_ORIGINS=http://localhost:5173
# API_DOCS_ENABLED=true

# ---------------------------------------------------------------- Web (apps/web)
# VITE_* values are compiled into the public browser bundle. Never put secrets in them.
# Leave unset on the web: /api is proxied (Vite dev server locally, Vercel rewrite in production).
# The Android build (M5) sets it to the Render API URL.
# VITE_API_BASE_URL=
